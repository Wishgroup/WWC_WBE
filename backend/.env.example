# ============================================================
# Wish Waves Club Backend – Environment
# Copy to .env and choose LOCAL or CPANEL below.
# ============================================================

# Server
PORT=3001
NODE_ENV=development
HOST=0.0.0.0
DISABLE_CCAVENUE=1
FRONTEND_URL=http://localhost:5173

# Logging (optional)
LOG_LEVEL=debug
# JWT (optional)
JWT_EXPIRES_IN=7d

# ==================== LOCAL MYSQL (Docker) ====================
# Use this when running backend on your machine with Docker.
# 1. Run: docker-compose up -d
# 2. Wait ~30s for MySQL to be ready, then: npm run migrate
# 3. Start backend: npm run dev
#
# If migrate fails with "Access denied" for wwc: use root for migration
# (Docker root password is root_local). Set DB_USER=root, DB_PASSWORD=root_local,
# run npm run migrate, then set back to wwc/wwc_local_secret for the app.
#
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wwc_local
DB_USER=wwc
DB_PASSWORD=wwc_local_secret

# ==================== CPANEL MYSQL ====================
# Use this when the backend runs on the same server as cPanel,
# or when connecting to cPanel’s remote MySQL from your machine.
#
# Get these from cPanel → MySQL® Databases:
# - Create a database (e.g. username_wwcdb)
# - Create a user (e.g. username_wwcuser) and set password
# - Add user to database, ALL PRIVILEGES
#
# If backend is ON the cPanel server, host is usually localhost.
# If backend is OFF the server (e.g. your laptop), use the host
# from cPanel → Remote MySQL® (e.g. yourdomain.com or server hostname).
# For remote access you may need to add your IP in “Access Hosts”.
#
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=wishwavesclub_db
# DB_USER=wishwavesclub_user
# DB_PASSWORD=your_database_password
#
# Optional for remote cPanel:
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false

# ==================== Email (subscription – info@wishwavesclub.com) ====================
# Secure SSL/TLS: mail.wishwavesclub.com, SMTP 465
# SMTP_HOST=mail.wishwavesclub.com
# SMTP_PORT=465
# SMTP_USER=info@wishwavesclub.com
# SMTP_PASS=use_the_email_account_password
# EMAIL_FROM=info@wishwavesclub.com
# SUBSCRIPTION_NOTIFY_EMAIL=info@wishwavesclub.com

# Security
JWT_SECRET=your_jwt_secret_min_32_chars
NFC_ENCRYPTION_KEY=your_nfc_key_32_chars
NFC_TOKEN_SECRET=your_nfc_token_secret
ADMIN_API_KEY=your_admin_api_key

# DESFire EV2 card credential signing (Phase 3). Support rotation via key_version.
# CARD_SIGNING_SECRET=your_card_signing_secret_min_32_chars
# CARD_SIGNING_SECRET_v1=optional_per_version_secret
# CARD_SIGNING_KEY_VERSION=1

# Rate limiting, fraud, bank transfer, upload dir, etc. – see main .env
